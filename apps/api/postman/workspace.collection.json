{
  "info": {
    "name": "Taskly - Workspace",
    "_postman_id": "6b9b2f9a-3d6c-4c79-87a1-0c2d718a2a77",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "PASTE_FIREBASE_ID_TOKEN_HERE" },
    { "key": "workspaceId", "value": "PASTE_WORKSPACE_ID_HERE" },
    { "key": "userId", "value": "PASTE_USER_ID_HERE" },
    { "key": "boardId", "value": "PASTE_BOARD_ID_HERE" },
    { "key": "invitationId", "value": "PASTE_INVITATION_ID_HERE" },
    { "key": "invitationToken", "value": "PASTE_INVITATION_TOKEN_HERE" }
  ],
  "item": [
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "List workspaces",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/workspaces", "host": ["{{baseUrl}}"], "path": ["api", "workspaces"] }
          }
        },
        {
          "name": "Create workspace",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Workspace\",\n  \"description\": \"Workspace created from Postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/workspaces", "host": ["{{baseUrl}}"], "path": ["api", "workspaces"] }
          }
        },
        {
          "name": "Get workspace by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}"]
            }
          }
        },
        {
          "name": "Update workspace (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Workspace (updated)\",\n  \"description\": \"Updated from Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}"]
            }
          }
        },
        {
          "name": "Archive workspace (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "members"]
            }
          }
        },
        {
          "name": "Add member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"role\": \"viewer\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "members"]
            }
          }
        },
        {
          "name": "Update member role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"editor\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/members/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "members", "{{userId}}"]
            }
          }
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/members/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "members", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Boards",
      "item": [
        {
          "name": "List boards",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/boards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "boards"]
            }
          }
        },
        {
          "name": "Create board",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"My Board\",\n  \"backgroundColor\": \"#1e293b\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/boards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "boards"]
            }
          }
        },
        {
          "name": "Reorder boards",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"boardIds\": [\"{{boardId}}\"]\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/boards/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "boards", "order"]
            }
          }
        },
        {
          "name": "Archive board",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/boards/{{boardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "boards", "{{boardId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Invitations",
      "item": [
        {
          "name": "Create invitation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"viewer\",\n  \"expiresInDays\": 7\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "invitations"]
            }
          }
        },
        {
          "name": "List invitations (pending)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "invitations"]
            }
          }
        },
        {
          "name": "Accept invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/invitations/{{invitationToken}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "invitations", "{{invitationToken}}", "accept"]
            }
          }
        },
        {
          "name": "Decline invitation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/invitations/{{invitationToken}}/decline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "invitations", "{{invitationToken}}", "decline"]
            }
          }
        },
        {
          "name": "Cancel invitation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/invitations/{{invitationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "invitations", "{{invitationId}}"]
            }
          }
        }
      ]
    }
  ]
}


